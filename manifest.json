{
  "manifest_version": 3,
  "name": "Arca",
  "version": "0.1.0",
  "description": "Rellena, sugiere y guarda contraseñas con tu bóveda local de Arca.",
  "key": "",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_title": "Arca",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "i18n.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "icons.js",
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "arca@arca.vault",
      "strict_min_version": "128.0"
    }
  }
}
